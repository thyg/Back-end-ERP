<?xml version="1.0" encoding="UTF-8"?>
<!--
    002 - Increment 3 Schema
    Treasury Module - RT-ComOps ERP
    
    This changelog creates tables for:
    - Bank Accounts
    - Bank Transactions
    - Checks (issued and received)
    
    Author: RT-ComOps Team
    Date: 2024-12-11
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- ====================================================================== -->
    <!-- CHANGESET 002-1: Create bank_accounts table                            -->
    <!-- ====================================================================== -->
    <changeSet id="002-1-create-bank-accounts-table" author="rtcomops">
        <comment>Create bank_accounts table for managing company bank accounts</comment>
        
        <createTable tableName="bank_accounts" schemaName="treasury">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bank_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="iban" type="VARCHAR(34)">
                <constraints nullable="true"/>
            </column>
            <column name="bic" type="VARCHAR(11)">
                <constraints nullable="true"/>
            </column>
            <column name="currency" type="VARCHAR(3)" defaultValue="EUR">
                <constraints nullable="false"/>
            </column>
            <column name="current_balance" type="DECIMAL(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="reconciled_balance" type="DECIMAL(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Foreign key to banks table -->
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="bank_accounts" 
            baseColumnNames="bank_id"
            referencedTableSchemaName="treasury"
            referencedTableName="banks" 
            referencedColumnNames="id"
            constraintName="fk_bank_accounts_bank_id"
            onDelete="RESTRICT"/>
        
        <!-- Indexes -->
        <createIndex indexName="idx_bank_accounts_bank_id" tableName="bank_accounts" schemaName="treasury">
            <column name="bank_id"/>
        </createIndex>
        <createIndex indexName="idx_bank_accounts_account_number" tableName="bank_accounts" schemaName="treasury">
            <column name="account_number"/>
        </createIndex>
        <createIndex indexName="idx_bank_accounts_is_active" tableName="bank_accounts" schemaName="treasury">
            <column name="is_active"/>
        </createIndex>
        
        <!-- Currency constraint -->
        <sql>
            ALTER TABLE treasury.bank_accounts 
            ADD CONSTRAINT chk_currency 
            CHECK (currency IN ('EUR', 'USD', 'XAF', 'XOF', 'GBP', 'CHF', 'CAD', 'JPY'));
        </sql>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- CHANGESET 002-2: Create bank_transactions table                        -->
    <!-- ====================================================================== -->
    <changeSet id="002-2-create-bank-transactions-table" author="rtcomops">
        <comment>Create bank_transactions table for manual bank transaction entries</comment>
        
        <createTable tableName="bank_transactions" schemaName="treasury">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bank_account_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_type_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="reference" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="value_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="direction" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="partner_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="is_reconciled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="reconciled_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Foreign keys -->
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="bank_transactions" 
            baseColumnNames="bank_account_id"
            referencedTableSchemaName="treasury"
            referencedTableName="bank_accounts" 
            referencedColumnNames="id"
            constraintName="fk_bank_transactions_account_id"
            onDelete="RESTRICT"/>
            
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="bank_transactions" 
            baseColumnNames="transaction_type_id"
            referencedTableSchemaName="treasury"
            referencedTableName="transaction_types" 
            referencedColumnNames="id"
            constraintName="fk_bank_transactions_type_id"
            onDelete="RESTRICT"/>
        
        <!-- Indexes -->
        <createIndex indexName="idx_bank_transactions_account_id" tableName="bank_transactions" schemaName="treasury">
            <column name="bank_account_id"/>
        </createIndex>
        <createIndex indexName="idx_bank_transactions_type_id" tableName="bank_transactions" schemaName="treasury">
            <column name="transaction_type_id"/>
        </createIndex>
        <createIndex indexName="idx_bank_transactions_date" tableName="bank_transactions" schemaName="treasury">
            <column name="transaction_date"/>
        </createIndex>
        <createIndex indexName="idx_bank_transactions_status" tableName="bank_transactions" schemaName="treasury">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_bank_transactions_reconciled" tableName="bank_transactions" schemaName="treasury">
            <column name="is_reconciled"/>
        </createIndex>
        
        <!-- Constraints -->
        <sql>
            ALTER TABLE treasury.bank_transactions 
            ADD CONSTRAINT chk_tx_direction 
            CHECK (direction IN ('CREDIT', 'DEBIT'));
        </sql>
        <sql>
            ALTER TABLE treasury.bank_transactions 
            ADD CONSTRAINT chk_tx_status 
            CHECK (status IN ('DRAFT', 'VALIDATED', 'CANCELLED'));
        </sql>
        <sql>
            ALTER TABLE treasury.bank_transactions 
            ADD CONSTRAINT chk_tx_amount_positive 
            CHECK (amount > 0);
        </sql>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- CHANGESET 002-3: Create checks table                                   -->
    <!-- ====================================================================== -->
    <changeSet id="002-3-create-checks-table" author="rtcomops">
        <comment>Create checks table for managing issued and received checks</comment>
        
        <createTable tableName="checks" schemaName="treasury">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bank_account_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="check_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="check_number" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="partner_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="issue_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="deposit_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="cashed_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="rejection_reason" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="bank_transaction_id" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Foreign keys -->
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="checks" 
            baseColumnNames="bank_account_id"
            referencedTableSchemaName="treasury"
            referencedTableName="bank_accounts" 
            referencedColumnNames="id"
            constraintName="fk_checks_account_id"
            onDelete="RESTRICT"/>
            
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="checks" 
            baseColumnNames="bank_transaction_id"
            referencedTableSchemaName="treasury"
            referencedTableName="bank_transactions" 
            referencedColumnNames="id"
            constraintName="fk_checks_transaction_id"
            onDelete="SET NULL"/>
        
        <!-- Indexes -->
        <createIndex indexName="idx_checks_account_id" tableName="checks" schemaName="treasury">
            <column name="bank_account_id"/>
        </createIndex>
        <createIndex indexName="idx_checks_check_number" tableName="checks" schemaName="treasury">
            <column name="check_number"/>
        </createIndex>
        <createIndex indexName="idx_checks_type" tableName="checks" schemaName="treasury">
            <column name="check_type"/>
        </createIndex>
        <createIndex indexName="idx_checks_status" tableName="checks" schemaName="treasury">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_checks_issue_date" tableName="checks" schemaName="treasury">
            <column name="issue_date"/>
        </createIndex>
        <createIndex indexName="idx_checks_due_date" tableName="checks" schemaName="treasury">
            <column name="due_date"/>
        </createIndex>
        
        <!-- Unique constraint: check_number + bank_account_id + check_type -->
        <addUniqueConstraint 
            schemaName="treasury"
            tableName="checks" 
            columnNames="check_number, bank_account_id, check_type"
            constraintName="uq_checks_number_account_type"/>
        
        <!-- Constraints -->
        <sql>
            ALTER TABLE treasury.checks 
            ADD CONSTRAINT chk_check_type 
            CHECK (check_type IN ('ISSUED', 'RECEIVED'));
        </sql>
        <sql>
            ALTER TABLE treasury.checks 
            ADD CONSTRAINT chk_check_status 
            CHECK (status IN ('PENDING', 'DEPOSITED', 'CASHED', 'REJECTED', 'CANCELLED'));
        </sql>
        <sql>
            ALTER TABLE treasury.checks 
            ADD CONSTRAINT chk_check_amount_positive 
            CHECK (amount > 0);
        </sql>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- CHANGESET 002-4: Add table comments                                    -->
    <!-- ====================================================================== -->
    <changeSet id="002-4-add-table-comments" author="rtcomops">
        <comment>Add documentation comments to increment 3 tables</comment>
        
        <sql>
            COMMENT ON TABLE treasury.bank_accounts IS 'Company bank accounts linked to banking institutions';
            COMMENT ON COLUMN treasury.bank_accounts.current_balance IS 'Current balance based on all transactions';
            COMMENT ON COLUMN treasury.bank_accounts.reconciled_balance IS 'Balance confirmed via bank statement reconciliation';
            
            COMMENT ON TABLE treasury.bank_transactions IS 'Manual bank transaction entries';
            COMMENT ON COLUMN treasury.bank_transactions.direction IS 'CREDIT for incoming, DEBIT for outgoing';
            COMMENT ON COLUMN treasury.bank_transactions.status IS 'DRAFT, VALIDATED, or CANCELLED';
            
            COMMENT ON TABLE treasury.checks IS 'Issued and received checks management';
            COMMENT ON COLUMN treasury.checks.check_type IS 'ISSUED for outgoing, RECEIVED for incoming checks';
            COMMENT ON COLUMN treasury.checks.status IS 'PENDING, DEPOSITED, CASHED, REJECTED, or CANCELLED';
        </sql>
    </changeSet>

</databaseChangeLog>
