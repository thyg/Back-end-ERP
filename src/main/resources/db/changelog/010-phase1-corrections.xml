<?xml version="1.0" encoding="UTF-8"?>
<!--
    010 - Phase 1 Corrections: Check & Checkbook Enhancements
    Treasury Module - RT-ComOps ERP

    Adds missing fields to checks (emit_date, receipt_date, reference_code, image_url, issuer_bank)
    and adapts checkbooks (rib→iban, number_of_pages).

    Author: RT-ComOps Team
    Date: 2026-01-22
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- ====================================================================== -->
    <!-- SECTION 1: CHECKS - Nouveaux champs                                    -->
    <!-- ====================================================================== -->

    <!-- 1.1 Ajouter colonne receipt_date pour les chèques reçus -->
    <changeSet id="010-1-add-check-receipt-date" author="rtcomops">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="checks" columnName="receipt_date" schemaName="treasury"/>
            </not>
        </preConditions>
        <addColumn schemaName="treasury" tableName="checks">
            <column name="receipt_date" type="DATE" remarks="Date de reception physique du cheque (pour cheques recus)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 1.2 Ajouter colonne emit_date pour les chèques émis -->
    <changeSet id="010-2-add-check-emit-date" author="rtcomops">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="checks" columnName="emit_date" schemaName="treasury"/>
            </not>
        </preConditions>
        <addColumn schemaName="treasury" tableName="checks">
            <column name="emit_date" type="DATE" remarks="Date d emission effective (remise au beneficiaire)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 1.3 Ajouter colonne reference_code (code de gestion unique) -->
    <changeSet id="010-3-add-check-reference-code" author="rtcomops">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="checks" columnName="reference_code" schemaName="treasury"/>
            </not>
        </preConditions>
        <addColumn schemaName="treasury" tableName="checks">
            <column name="reference_code" type="VARCHAR(50)" remarks="Code de gestion unique (CHQ-YYYYMM-NNNN)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <createIndex schemaName="treasury" tableName="checks" indexName="idx_checks_reference_code">
            <column name="reference_code"/>
        </createIndex>
    </changeSet>

    <!-- 1.4 Ajouter colonne image_url pour photo du chèque -->
    <changeSet id="010-4-add-check-image-url" author="rtcomops">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="checks" columnName="image_url" schemaName="treasury"/>
            </not>
        </preConditions>
        <addColumn schemaName="treasury" tableName="checks">
            <column name="image_url" type="VARCHAR(500)" remarks="URL de l image/photo du cheque">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 1.5 Ajouter colonne issuer_bank pour la banque émettrice (chèques reçus) -->
    <changeSet id="010-5-add-check-issuer-bank" author="rtcomops">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="checks" columnName="issuer_bank" schemaName="treasury"/>
            </not>
        </preConditions>
        <addColumn schemaName="treasury" tableName="checks">
            <column name="issuer_bank" type="VARCHAR(100)" remarks="Nom de la banque emettrice (pour cheques recus)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- SECTION 2: CHECKBOOKS - Renommer rib→iban, ajouter number_of_pages     -->
    <!-- ====================================================================== -->

    <!-- 2.1 Renommer rib en iban dans checkbooks -->
    <changeSet id="010-6-rename-checkbook-rib-to-iban" author="rtcomops">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="checkbooks" columnName="rib" schemaName="treasury"/>
            <not>
                <columnExists tableName="checkbooks" columnName="iban" schemaName="treasury"/>
            </not>
        </preConditions>
        <renameColumn schemaName="treasury" tableName="checkbooks"
                      oldColumnName="rib"
                      newColumnName="iban"
                      columnDataType="VARCHAR(50)"/>
    </changeSet>

    <!-- 2.2 Ajouter colonne number_of_pages -->
    <changeSet id="010-7-add-checkbook-number-of-pages" author="rtcomops">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="checkbooks" columnName="number_of_pages" schemaName="treasury"/>
            </not>
        </preConditions>
        <addColumn schemaName="treasury" tableName="checkbooks">
            <column name="number_of_pages" type="INTEGER" remarks="Nombre de feuilles dans le chequier">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 2.3 Migrer les données existantes (calculer number_of_pages) -->
    <changeSet id="010-8-migrate-checkbook-pages-data" author="rtcomops">
        <sql>
            UPDATE treasury.checkbooks
            SET number_of_pages = (end_number - start_number + 1)
            WHERE number_of_pages IS NULL
            AND start_number IS NOT NULL
            AND end_number IS NOT NULL;
        </sql>
        <comment>Calculer number_of_pages a partir des donnees existantes</comment>
    </changeSet>

</databaseChangeLog>
