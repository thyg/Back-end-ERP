<?xml version="1.0" encoding="UTF-8"?>
<!--
    003 - Increment 4 Schema
    Treasury Module - RT-ComOps ERP
    
    This changelog creates tables for:
    - Bank Statements (imported bank statements)
    - Statement Lines (individual lines from statements)
    - Reconciliation Matches (links between internal transactions and statement lines)
    
    Author: RT-ComOps Team
    Date: 2024-12-11
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- ====================================================================== -->
    <!-- CHANGESET 003-1: Create bank_statements table                          -->
    <!-- ====================================================================== -->
    <changeSet id="003-1-create-bank-statements-table" author="rtcomops">
        <comment>Create bank_statements table for imported bank statements</comment>
        
        <createTable tableName="bank_statements" schemaName="treasury">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bank_account_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="reference" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="statement_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="opening_balance" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="closing_balance" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="total_credits" type="DECIMAL(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_debits" type="DECIMAL(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="line_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="reconciled_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="IMPORTED">
                <constraints nullable="false"/>
            </column>
            <column name="import_source" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="notes" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Foreign key to bank_accounts -->
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="bank_statements" 
            baseColumnNames="bank_account_id"
            referencedTableSchemaName="treasury"
            referencedTableName="bank_accounts" 
            referencedColumnNames="id"
            constraintName="fk_bank_statements_account_id"
            onDelete="RESTRICT"/>
        
        <!-- Indexes -->
        <createIndex indexName="idx_bank_statements_account_id" tableName="bank_statements" schemaName="treasury">
            <column name="bank_account_id"/>
        </createIndex>
        <createIndex indexName="idx_bank_statements_date" tableName="bank_statements" schemaName="treasury">
            <column name="statement_date"/>
        </createIndex>
        <createIndex indexName="idx_bank_statements_status" tableName="bank_statements" schemaName="treasury">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_bank_statements_period" tableName="bank_statements" schemaName="treasury">
            <column name="period_start"/>
            <column name="period_end"/>
        </createIndex>
        
        <!-- Status constraint -->
        <sql>
            ALTER TABLE treasury.bank_statements 
            ADD CONSTRAINT chk_statement_status 
            CHECK (status IN ('IMPORTED', 'IN_PROGRESS', 'RECONCILED', 'CLOSED'));
        </sql>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- CHANGESET 003-2: Create statement_lines table                          -->
    <!-- ====================================================================== -->
    <changeSet id="003-2-create-statement-lines-table" author="rtcomops">
        <comment>Create statement_lines table for individual statement entries</comment>
        
        <createTable tableName="statement_lines" schemaName="treasury">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bank_statement_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="line_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="value_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="direction" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="reference" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="partner_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="partner_account" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="balance_after" type="DECIMAL(15,2)">
                <constraints nullable="true"/>
            </column>
            <column name="reconciliation_status" type="VARCHAR(20)" defaultValue="UNMATCHED">
                <constraints nullable="false"/>
            </column>
            <column name="reconciled_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="raw_data" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Foreign key to bank_statements -->
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="statement_lines" 
            baseColumnNames="bank_statement_id"
            referencedTableSchemaName="treasury"
            referencedTableName="bank_statements" 
            referencedColumnNames="id"
            constraintName="fk_statement_lines_statement_id"
            onDelete="CASCADE"/>
        
        <!-- Indexes -->
        <createIndex indexName="idx_statement_lines_statement_id" tableName="statement_lines" schemaName="treasury">
            <column name="bank_statement_id"/>
        </createIndex>
        <createIndex indexName="idx_statement_lines_date" tableName="statement_lines" schemaName="treasury">
            <column name="transaction_date"/>
        </createIndex>
        <createIndex indexName="idx_statement_lines_status" tableName="statement_lines" schemaName="treasury">
            <column name="reconciliation_status"/>
        </createIndex>
        <createIndex indexName="idx_statement_lines_reference" tableName="statement_lines" schemaName="treasury">
            <column name="reference"/>
        </createIndex>
        
        <!-- Unique constraint: line_number per statement -->
        <addUniqueConstraint 
            schemaName="treasury"
            tableName="statement_lines" 
            columnNames="bank_statement_id, line_number"
            constraintName="uq_statement_lines_number"/>
        
        <!-- Constraints -->
        <sql>
            ALTER TABLE treasury.statement_lines 
            ADD CONSTRAINT chk_line_direction 
            CHECK (direction IN ('CREDIT', 'DEBIT'));
        </sql>
        <sql>
            ALTER TABLE treasury.statement_lines 
            ADD CONSTRAINT chk_line_reconciliation_status 
            CHECK (reconciliation_status IN ('UNMATCHED', 'MATCHED', 'PARTIALLY_MATCHED', 'IGNORED'));
        </sql>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- CHANGESET 003-3: Create reconciliation_matches table                   -->
    <!-- ====================================================================== -->
    <changeSet id="003-3-create-reconciliation-matches-table" author="rtcomops">
        <comment>Create reconciliation_matches table for linking transactions to statement lines</comment>
        
        <createTable tableName="reconciliation_matches" schemaName="treasury">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="statement_line_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="bank_transaction_id" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="check_id" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="match_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="match_method" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="matched_amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="confidence_score" type="DECIMAL(5,2)">
                <constraints nullable="true"/>
            </column>
            <column name="notes" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="matched_by" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Foreign keys -->
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="reconciliation_matches" 
            baseColumnNames="statement_line_id"
            referencedTableSchemaName="treasury"
            referencedTableName="statement_lines" 
            referencedColumnNames="id"
            constraintName="fk_reconciliation_statement_line"
            onDelete="CASCADE"/>
            
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="reconciliation_matches" 
            baseColumnNames="bank_transaction_id"
            referencedTableSchemaName="treasury"
            referencedTableName="bank_transactions" 
            referencedColumnNames="id"
            constraintName="fk_reconciliation_transaction"
            onDelete="SET NULL"/>
            
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="reconciliation_matches" 
            baseColumnNames="check_id"
            referencedTableSchemaName="treasury"
            referencedTableName="checks" 
            referencedColumnNames="id"
            constraintName="fk_reconciliation_check"
            onDelete="SET NULL"/>
        
        <!-- Indexes -->
        <createIndex indexName="idx_reconciliation_statement_line" tableName="reconciliation_matches" schemaName="treasury">
            <column name="statement_line_id"/>
        </createIndex>
        <createIndex indexName="idx_reconciliation_transaction" tableName="reconciliation_matches" schemaName="treasury">
            <column name="bank_transaction_id"/>
        </createIndex>
        <createIndex indexName="idx_reconciliation_check" tableName="reconciliation_matches" schemaName="treasury">
            <column name="check_id"/>
        </createIndex>
        
        <!-- Constraints -->
        <sql>
            ALTER TABLE treasury.reconciliation_matches 
            ADD CONSTRAINT chk_match_type 
            CHECK (match_type IN ('TRANSACTION', 'CHECK', 'MULTIPLE', 'PARTIAL'));
        </sql>
        <sql>
            ALTER TABLE treasury.reconciliation_matches 
            ADD CONSTRAINT chk_match_method 
            CHECK (match_method IN ('AUTO_EXACT', 'AUTO_FUZZY', 'MANUAL', 'RULE_BASED'));
        </sql>
        <sql>
            ALTER TABLE treasury.reconciliation_matches 
            ADD CONSTRAINT chk_has_target 
            CHECK (bank_transaction_id IS NOT NULL OR check_id IS NOT NULL);
        </sql>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- CHANGESET 003-4: Add reconciliation columns to bank_transactions       -->
    <!-- ====================================================================== -->
    <changeSet id="003-4-add-statement-line-to-transactions" author="rtcomops">
        <comment>Add statement_line_id reference to bank_transactions for direct linking</comment>
        
        <addColumn tableName="bank_transactions" schemaName="treasury">
            <column name="statement_line_id" type="UUID">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addForeignKeyConstraint 
            baseTableSchemaName="treasury"
            baseTableName="bank_transactions" 
            baseColumnNames="statement_line_id"
            referencedTableSchemaName="treasury"
            referencedTableName="statement_lines" 
            referencedColumnNames="id"
            constraintName="fk_transactions_statement_line"
            onDelete="SET NULL"/>
            
        <createIndex indexName="idx_transactions_statement_line" tableName="bank_transactions" schemaName="treasury">
            <column name="statement_line_id"/>
        </createIndex>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- CHANGESET 003-5: Add table comments                                    -->
    <!-- ====================================================================== -->
    <changeSet id="003-5-add-table-comments" author="rtcomops">
        <comment>Add documentation comments to increment 4 tables</comment>
        
        <sql>
            COMMENT ON TABLE treasury.bank_statements IS 'Imported bank statements for reconciliation';
            COMMENT ON COLUMN treasury.bank_statements.status IS 'IMPORTED, IN_PROGRESS, RECONCILED, or CLOSED';
            COMMENT ON COLUMN treasury.bank_statements.reconciled_count IS 'Number of lines that have been reconciled';
            
            COMMENT ON TABLE treasury.statement_lines IS 'Individual lines from bank statements';
            COMMENT ON COLUMN treasury.statement_lines.reconciliation_status IS 'UNMATCHED, MATCHED, PARTIALLY_MATCHED, or IGNORED';
            COMMENT ON COLUMN treasury.statement_lines.raw_data IS 'Original raw data from import for audit';
            
            COMMENT ON TABLE treasury.reconciliation_matches IS 'Links between statement lines and internal transactions/checks';
            COMMENT ON COLUMN treasury.reconciliation_matches.match_type IS 'TRANSACTION, CHECK, MULTIPLE, or PARTIAL';
            COMMENT ON COLUMN treasury.reconciliation_matches.match_method IS 'AUTO_EXACT, AUTO_FUZZY, MANUAL, or RULE_BASED';
            COMMENT ON COLUMN treasury.reconciliation_matches.confidence_score IS 'Auto-match confidence 0-100';
        </sql>
    </changeSet>

</databaseChangeLog>
