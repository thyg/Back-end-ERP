<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- ====================================================================== -->
    <!-- INCRÉMENT 5: Journal des Opérations (Audit Logs)                       -->
    <!-- ====================================================================== -->
    <!-- Version: 1.0.0                                                         -->
    <!-- Date: 2024-12-13                                                       -->
    <!-- Description: Table pour stocker l'historique de toutes les opérations  -->
    <!-- ====================================================================== -->

    <!-- ====================================================================== -->
    <!-- TABLE: audit_logs                                                      -->
    <!-- ====================================================================== -->
    <changeSet id="increment5-001-create-audit-logs-table" author="thedom">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="treasury" tableName="audit_logs"/>
            </not>
        </preConditions>
        
        <createTable schemaName="treasury" tableName="audit_logs"
                     remarks="Journal des opérations - Historique complet des actions du module Treasury">
            
            <!-- Identifiant -->
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"
                    remarks="Identifiant unique de l'entrée d'audit">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <!-- Module & Action -->
            <column name="module" type="VARCHAR(50)"
                    remarks="Module concerné: BANK, BANK_ACCOUNT, TRANSACTION_TYPE, BANK_TRANSACTION, CHECK, BANK_STATEMENT, STATEMENT_LINE, RECONCILIATION">
                <constraints nullable="false"/>
            </column>
            
            <column name="action" type="VARCHAR(50)"
                    remarks="Action effectuée: CREATE, UPDATE, DELETE, VALIDATE, CANCEL, DEPOSIT, CASH, REJECT, IMPORT, CLOSE, MANUAL_MATCH, AUTO_MATCH, UNMATCH, IGNORE, RESET">
                <constraints nullable="false"/>
            </column>
            
            <!-- Entité concernée -->
            <column name="entity_id" type="UUID"
                    remarks="UUID de l'entité concernée par l'action">
                <constraints nullable="false"/>
            </column>
            
            <column name="entity_reference" type="VARCHAR(100)"
                    remarks="Référence lisible de l'entité (ex: CHQ-001234)"/>
            
            <!-- Utilisateur -->
            <column name="user_id" type="UUID"
                    remarks="ID de l'utilisateur ayant effectué l'action (NULL si système)"/>
            
            <column name="user_name" type="VARCHAR(100)"
                    remarks="Nom de l'utilisateur pour affichage"/>
            
            <!-- Changements (Avant/Après) -->
            <column name="old_value" type="JSONB"
                    remarks="État de l'entité AVANT modification (JSON) - NULL pour CREATE"/>
            
            <column name="new_value" type="JSONB"
                    remarks="État de l'entité APRÈS modification (JSON) - NULL pour DELETE"/>
            
            <!-- Contexte technique -->
            <column name="ip_address" type="VARCHAR(45)"
                    remarks="Adresse IP du client (IPv4 ou IPv6)"/>
            
            <column name="user_agent" type="TEXT"
                    remarks="User-Agent du navigateur/client"/>
            
            <column name="description" type="TEXT"
                    remarks="Description humaine de l'action effectuée"/>
            
            <!-- Timestamp -->
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" 
                    defaultValueComputed="CURRENT_TIMESTAMP"
                    remarks="Date et heure de l'action">
                <constraints nullable="false"/>
            </column>
            
        </createTable>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- INDEX SIMPLES                                                          -->
    <!-- ====================================================================== -->
    <changeSet id="increment5-002-create-audit-logs-indexes" author="thedom">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="treasury" tableName="audit_logs"/>
        </preConditions>
        
        <!-- Index sur le module -->
        <createIndex schemaName="treasury" tableName="audit_logs" 
                     indexName="idx_audit_logs_module">
            <column name="module"/>
        </createIndex>
        
        <!-- Index sur l'action -->
        <createIndex schemaName="treasury" tableName="audit_logs" 
                     indexName="idx_audit_logs_action">
            <column name="action"/>
        </createIndex>
        
        <!-- Index sur l'entité -->
        <createIndex schemaName="treasury" tableName="audit_logs" 
                     indexName="idx_audit_logs_entity_id">
            <column name="entity_id"/>
        </createIndex>
        
        <!-- Index sur l'utilisateur -->
        <createIndex schemaName="treasury" tableName="audit_logs" 
                     indexName="idx_audit_logs_user_id">
            <column name="user_id"/>
        </createIndex>
        
        <!-- Index sur la date (DESC pour tri chronologique inverse) -->
        <createIndex schemaName="treasury" tableName="audit_logs" 
                     indexName="idx_audit_logs_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- INDEX COMPOSITES                                                       -->
    <!-- ====================================================================== -->
    <changeSet id="increment5-003-create-audit-logs-composite-indexes" author="thedom">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="treasury" tableName="audit_logs"/>
        </preConditions>
        
        <!-- Index composite module + action -->
        <createIndex schemaName="treasury" tableName="audit_logs" 
                     indexName="idx_audit_logs_module_action">
            <column name="module"/>
            <column name="action"/>
        </createIndex>
        
        <!-- Index composite module + date -->
        <createIndex schemaName="treasury" tableName="audit_logs" 
                     indexName="idx_audit_logs_module_date">
            <column name="module"/>
            <column name="created_at" descending="true"/>
        </createIndex>
        
        <!-- Index composite utilisateur + date -->
        <createIndex schemaName="treasury" tableName="audit_logs" 
                     indexName="idx_audit_logs_user_date">
            <column name="user_id"/>
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- INDEX GIN POUR RECHERCHE TEXTUELLE                                     -->
    <!-- ====================================================================== -->
    <changeSet id="increment5-004-create-audit-logs-gin-indexes" author="thedom">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="treasury" tableName="audit_logs"/>
        </preConditions>
        
        <!-- Index GIN sur la description (recherche full-text français) -->
        <sql>
            CREATE INDEX IF NOT EXISTS idx_audit_logs_description_gin 
            ON treasury.audit_logs USING gin(to_tsvector('french', COALESCE(description, '')));
        </sql>
        
        <!-- Index GIN sur la référence (recherche partielle) -->
        <sql>
            CREATE INDEX IF NOT EXISTS idx_audit_logs_reference_gin 
            ON treasury.audit_logs USING gin(to_tsvector('simple', COALESCE(entity_reference, '')));
        </sql>
    </changeSet>

    <!-- ====================================================================== -->
    <!-- CONTRAINTES CHECK                                                      -->
    <!-- ====================================================================== -->
    <changeSet id="increment5-005-create-audit-logs-constraints" author="thedom">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="treasury" tableName="audit_logs"/>
        </preConditions>
        
        <!-- Contrainte sur les valeurs de module -->
        <sql>
            ALTER TABLE treasury.audit_logs 
            ADD CONSTRAINT chk_audit_logs_module 
            CHECK (module IN (
                'BANK', 'BANK_ACCOUNT', 'TRANSACTION_TYPE', 'BANK_TRANSACTION',
                'CHECK', 'BANK_STATEMENT', 'STATEMENT_LINE', 'RECONCILIATION'
            ));
        </sql>
        
        <!-- Contrainte sur les valeurs d'action -->
        <sql>
            ALTER TABLE treasury.audit_logs 
            ADD CONSTRAINT chk_audit_logs_action 
            CHECK (action IN (
                'CREATE', 'UPDATE', 'DELETE', 'VIEW',
                'ACTIVATE', 'DEACTIVATE',
                'VALIDATE', 'CANCEL',
                'DEPOSIT', 'CASH', 'REJECT',
                'IMPORT', 'CLOSE',
                'MANUAL_MATCH', 'AUTO_MATCH', 'UNMATCH',
                'IGNORE', 'RESET'
            ));
        </sql>
    </changeSet>

</databaseChangeLog>